[Unit]
Description=EnvSave License Server
After=network.target

[Service]
Type=simple
User=jcsancho
WorkingDirectory=/home/jcsancho/envsave
ExecStart=/home/jcsancho/.bun/bin/bun run webapp/server.ts
EnvironmentFile=/home/jcsancho/envsave/.env
Environment=NODE_ENV=production
Environment=ENVSAVE_PORT=3900
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
