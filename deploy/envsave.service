[Unit]
Description=EnvSave License Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/envsave
ExecStart=/usr/local/bin/bun run webapp/server.ts
Restart=always
RestartSec=5
Environment=ENVSAVE_PORT=3900
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
